# Database（開發環境使用 SQLite，正式環境可改用 PostgreSQL）
DATABASE_URL="file:./dev.db"

# Session 簽章密鑰（正式環境必填，請用 openssl rand -base64 32 產生）
AUTH_SECRET="change-me-in-production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 簡訊閘道（選填；未設定時通知以「模擬發送」記錄，不會實際發出）
# 支援任何 HTTP POST + Bearer Token 的簡訊服務（三竹、every8d、Twilio proxy 等）
# SMS_API_URL="https://sms-provider.example.com/send"
# SMS_API_KEY="your-sms-api-key"

# 排程密鑰（選填；外部排程器每日呼叫 POST /api/notifications/remind
# 並帶 x-cron-secret header 即可自動發送明日預約提醒）
# CRON_SECRET="your-random-cron-secret"
