# Database（開發環境使用 SQLite，正式環境可改用 PostgreSQL）
DATABASE_URL="file:./dev.db"

# Session 簽章密鑰（正式環境必填，請用 openssl rand -base64 32 產生）
AUTH_SECRET="change-me-in-production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LINE 通知：不需環境變數。各分店於後台「LINE 通知 → LINE 串接設定」
# 貼上商家自有 LINE 官方帳號的 Channel Access Token / Secret 即啟用。

# 排程密鑰（選填；外部排程器每日呼叫 POST /api/notifications/remind
# 並帶 x-cron-secret header 即可自動發送明日預約提醒）
# CRON_SECRET="your-random-cron-secret"

# Stripe 訂閱金流（選填；未設定時訂閱頁為示範模式）
# 1. Stripe Dashboard 建立 6 個 Price（TWD recurring）：
#    基礎 月 399 / 年 3830、進階 月 599 / 年 5750、專業 月 799 / 年 7670
# 2. Webhook 端點設為 https://你的網域/api/webhooks/stripe
#    事件：checkout.session.completed、customer.subscription.*
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_BASIC_MONTHLY="price_..."
# STRIPE_PRICE_BASIC_YEARLY="price_..."
# STRIPE_PRICE_PLUS_MONTHLY="price_..."
# STRIPE_PRICE_PLUS_YEARLY="price_..."
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# STRIPE_PRICE_PRO_YEARLY="price_..."
