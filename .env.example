# Database（開發環境使用 SQLite，正式環境可改用 PostgreSQL）
DATABASE_URL="file:./dev.db"

# Session 簽章密鑰（正式環境必填，請用 openssl rand -base64 32 產生）
AUTH_SECRET="change-me-in-production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LINE 通知：不需環境變數。各分店於後台「LINE 通知 → LINE 串接設定」
# 貼上商家自有 LINE 官方帳號的 Channel Access Token / Secret 即啟用。

# 排程密鑰（選填；外部排程器每日呼叫 POST /api/notifications/remind
# 並帶 x-cron-secret header 即可自動發送明日預約提醒）
# CRON_SECRET="your-random-cron-secret"

# 綠界 ECPay 訂閱金流（選填；未設定時訂閱頁為示範模式）
# 申請綠界特約會員並開通「信用卡定期定額」後，填入以下金鑰即啟用：
# ECPAY_MERCHANT_ID="你的特店編號"
# ECPAY_HASH_KEY="你的 HashKey"
# ECPAY_HASH_IV="你的 HashIV"
# 預設使用綠界測試環境；上線時設 ECPAY_STAGE="false" 切換正式環境
# 付款結果通知網址（系統自動帶入）：https://你的網域/api/webhooks/ecpay
# ECPAY_STAGE="false"
