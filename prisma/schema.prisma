generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 分店
model Store {
  id        String  @id @default(cuid())
  name      String
  phone     String?
  address   String?
  openTime  String  @default("10:00")
  closeTime String  @default("20:00")

  // 打卡限制。clockMode: ANY 不限制 | IP 限店內網路 | GPS 限店面位置
  clockMode  String  @default("ANY")
  allowedIps String? // 逗號分隔的允許 IP
  latitude   Float?
  longitude  Float?
  radiusM    Int     @default(150) // GPS 允許半徑（公尺）

  // 薪資規則
  lateGraceMin        Int @default(5) // 遲到寬限（分鐘）
  latePerMin          Int @default(10) // 遲到扣款（NT$/分鐘）
  fullAttendanceBonus Int @default(1000) // 全勤獎金

  staff Staff[]
}

// 員工（含管理者）。role: ADMIN | MANAGER | STAFF
model Staff {
  id                String        @id @default(cuid())
  storeId           String
  store             Store         @relation(fields: [storeId], references: [id])
  name              String
  email             String        @unique
  password          String // sha256 hex
  role              String        @default("STAFF")
  title             String? // 職稱：髮型設計師 / 美甲師 / 美睫師 / 芳療師 / 美容師
  phone             String?
  payType           String        @default("MONTHLY") // MONTHLY 底薪+抽成 | HOURLY 時薪制
  baseSalary        Int           @default(0) // 月底薪（MONTHLY）
  hourlyRate        Int           @default(0) // 時薪（HOURLY）
  serviceCommission Float         @default(0.1) // 服務業績抽成
  productCommission Float         @default(0.05) // 產品銷售抽成
  color             String        @default("#f97316") // 排班 / 行事曆顯示色
  permissions       String? // 員工可見頁籤（逗號分隔；null = 預設全部開放）
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  timeRecords       TimeRecord[]
  shifts            Shift[]
  leaves            Leave[]
  appointments      Appointment[]
  saleItems         SaleItem[]
  salesAsCashier    Sale[]        @relation("cashier")
  balanceTxs        BalanceTransaction[]
}

// 打卡紀錄
model TimeRecord {
  id       String    @id @default(cuid())
  staffId  String
  staff    Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workDate String // YYYY-MM-DD
  clockIn  DateTime
  clockOut DateTime?
  note     String?

  @@index([staffId, workDate])
}

// 請假。leaveType: PERSONAL 事假 | SICK 病假
model Leave {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workDate  String // YYYY-MM-DD
  leaveType String
  days      Float   @default(1) // 1 = 全天、0.5 = 半天
  note      String?

  @@unique([staffId, workDate])
}

// 排班。shiftType: MORNING | EVENING | FULL | OFF | CUSTOM（自訂時間）
model Shift {
  id        String @id @default(cuid())
  staffId   String
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workDate  String // YYYY-MM-DD
  shiftType String @default("FULL")
  startTime String @default("10:00")
  endTime   String @default("20:00")

  @@unique([staffId, workDate])
}

// 顧客資料
model Customer {
  id           String         @id @default(cuid())
  name         String
  phone        String         @unique
  email        String?
  gender       String? // F | M | OTHER
  birthday     String? // YYYY-MM-DD
  note         String? // 過敏注意、偏好設計師、髮況等
  tags         String? // 逗號分隔：VIP,染燙客,敏感肌
  balance      Int            @default(0) // 儲值金餘額
  createdAt    DateTime       @default(now())
  appointments Appointment[]
  sales        Sale[]
  passes       CustomerPass[]
  photos       CustomerPhoto[]
  balanceTxs   BalanceTransaction[]
}

// 儲值金異動紀錄。kind: TOPUP 儲值 | SPEND 消費折抵 | ADJUST 人工調整
model BalanceTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String? // 操作人員
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  amount     Int // 正數加值、負數扣款
  kind       String   @default("TOPUP")
  note       String?
  saleId     String?
  createdAt  DateTime @default(now())
}

// 療程券方案（先建立方案，開券時從下拉選單選擇）
model PassTemplate {
  id            String  @id @default(cuid())
  name          String
  totalSessions Int
  validDays     Int     @default(180)
  price         Int     @default(0)
  active        Boolean @default(true)
}

// 顧客施作紀錄照片
model CustomerPhoto {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fileName   String // 儲存於 uploads/ 的檔名
  caption    String?
  createdAt  DateTime @default(now())
}

// 療程券 / 堂數券（例：臉部護理 10 堂）
model CustomerPass {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name          String
  totalSessions Int
  usedSessions  Int       @default(0)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

// 服務項目。category: HAIR | NAIL | LASH | SPA | FACIAL
model Service {
  id            String        @id @default(cuid())
  name          String
  category      String
  price         Int
  durationMin   Int           @default(60)
  depositAmount Int           @default(0) // 線上預約訂金（0 = 免訂金）
  description   String?
  active        Boolean       @default(true)
  appointments  Appointment[]
}

// 販售產品（含庫存）
model Product {
  id         String  @id @default(cuid())
  name       String
  category   String?
  price      Int
  cost       Int     @default(0)
  stock      Int     @default(0)
  lowStockAt Int     @default(5) // 低庫存警示門檻
  active     Boolean @default(true)
}

// 預約。status: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
// source: ONLINE | PHONE | WALK_IN
model Appointment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  date       String // YYYY-MM-DD
  startAt    DateTime
  endAt      DateTime
  status     String   @default("PENDING")
  source     String   @default("WALK_IN")
  note       String?
  // 訂金。depositStatus: NONE | UNPAID | PAID | REFUNDED
  depositAmount Int      @default(0)
  depositStatus String   @default("NONE")
  depositPaidAt DateTime?
  createdAt  DateTime @default(now())

  notifications Notification[]

  @@index([date])
  @@index([staffId, date])
}

// 通知紀錄（簡訊 / LINE）。status: SENT | SIMULATED | FAILED
model Notification {
  id            String       @id @default(cuid())
  channel       String // SMS | LINE
  recipient     String
  message       String
  status        String       @default("SIMULATED")
  kind          String // BOOKING_RECEIVED | BOOKING_CONFIRMED | REMINDER | DEPOSIT_PAID
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

// POS 結帳單。paymentMethod: CASH | CARD | TRANSFER | BALANCE
model Sale {
  id            String     @id @default(cuid())
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  cashierId     String
  cashier       Staff      @relation("cashier", fields: [cashierId], references: [id])
  subtotal      Int
  discount      Int        @default(0)
  total         Int
  paymentMethod String     @default("CASH")
  note          String?
  createdAt     DateTime   @default(now())
  items         SaleItem[]
}

// 結帳明細（staffId = 業績歸屬人）。itemType: SERVICE | PRODUCT
model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id])
  itemType  String
  serviceId String?
  productId String?
  name      String
  unitPrice Int
  qty       Int     @default(1)
  subtotal  Int
}
